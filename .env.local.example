# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # "service_role" key -> SÓ no servidor, nunca commitar

# ---- Bloco B: avaliações do Google via Featurable (grátis, sem cartão) ----
# https://featurable.com -> crie um widget para o local -> copie o Widget ID
# (aparece na URL do widget, no código de embed e no link da API).
# Deixe vazio para desativar a seção "Do Google".
FEATURABLE_WIDGET_ID=

# ---- Carrossel do Instagram via Behold.so (grátis) ----
# https://behold.so -> conecte o Instagram -> copie o Feed ID
# (link da API: https://feeds.behold.so/<feedId>). Vazio = seção escondida.
BEHOLD_FEED_ID=

# ---- Cardápio (CardápioWeb) ----
# o slug da URL: app.cardapioweb.com/<slug>. Vazio = seção escondida.
CARDAPIOWEB_SLUG=tio_bar_e_restaurante

# ---- Mapa (seção antes do footer) ----
# Opção A (mais precisa): no Google Maps, "Compartilhar > Incorporar um mapa",
# copie SÓ o valor de src="..." do iframe para cá:
NEXT_PUBLIC_MAPS_EMBED_URL=
# Opção B (fallback): texto de busca do local (usado se A estiver vazio)
NEXT_PUBLIC_MAPS_QUERY=Tio Bar e Restaurante
# Opcional: Place ID, deixa o botão "Como chegar" mais preciso
NEXT_PUBLIC_MAPS_PLACE_ID=

# ---- App ----
# Emails que podem acessar /admin (separados por vírgula)
ADMIN_EMAILS=voce@exemplo.com
# URL pública do site (em dev pode deixar http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Segredo do cron da Vercel (opcional; gere uma string aleatória). A Vercel injeta isso automaticamente.
CRON_SECRET=
